# Which content source the site builds from. See src/lib/content.ts.
#
#   local   (default) read <site>/content/*.json. No CMS needs to be running.
#           Use this for the whole iteration phase: fast loop with the client.
#   payload read a running Payload instance over REST at build time.
#           Use this after handoff, once content has been imported into the CMS.
CONTENT_SOURCE=local

# Only used when CONTENT_SOURCE=payload. Must match the port Payload actually
# bound to (read the dev server's startup log, don't assume the default).
PAYLOAD_URL=http://localhost:3457
