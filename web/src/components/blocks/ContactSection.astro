---
import type { ContactSectionBlock } from '../../lib/types'
import { renderRichText } from '../../lib/richtext'
import { getSiteSettings } from '../../lib/content'

const { heading, showForm, additionalInfo } = Astro.props as ContactSectionBlock
const infoHtml = renderRichText(additionalInfo)
const siteSettings = await getSiteSettings()
---

<section class="reveal mx-auto max-w-6xl px-6 py-14 md:py-24 lg:py-32 grid md:grid-cols-2 gap-10 md:gap-12 lg:gap-16">
  <div>
    <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-semibold text-brand-secondary text-balance">{heading}</h2>
    {/* Tap-to-call, not a plain string. This is the cheapest example of the
        "what does mobile get that desktop doesn't" question the responsive
        pass has to answer for every block: on a phone this is the primary
        conversion action on the page, and printing the number as inert text
        makes the visitor memorise it and retype it. It costs nothing on
        desktop, where the same href hands off to the OS dialer or is simply
        ignored. py-1 -my-1 keeps the tap area at a usable height without
        changing the visual rhythm of the list. */}
    <div class="mt-6 space-y-3 text-brand-secondary/80">
      {siteSettings.contact?.phone && (
        <a href={`tel:${siteSettings.contact.phone}`} class="flex items-center gap-3 py-1 -my-1 hover:text-brand-accent-strong transition-colors duration-(--motion-fast) ease-brand">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-accent-strong" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {siteSettings.contact.phone}
        </a>
      )}
      {siteSettings.contact?.email && (
        <a href={`mailto:${siteSettings.contact.email}`} class="flex items-center gap-3 py-1 -my-1 hover:text-brand-accent-strong transition-colors duration-(--motion-fast) ease-brand">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-accent-strong" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 6-10 7L2 6"/>
          </svg>
          {siteSettings.contact.email}
        </a>
      )}
      {siteSettings.contact?.address && (
        <p class="flex items-center gap-3">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-accent-strong" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {siteSettings.contact.address}
        </p>
      )}
    </div>
    {siteSettings.contact?.hours && siteSettings.contact.hours.length > 0 && (
      <div class="mt-6 rounded-brand-lg border border-black/5 bg-brand-neutral p-5">
        <p class="font-semibold text-brand-secondary">Hours</p>
        <ul class="mt-2 text-sm text-brand-secondary/70 space-y-1">
          {siteSettings.contact.hours.map((h) => (
            <li class="flex justify-between gap-4"><span>{h.days}</span><span>{h.hours}</span></li>
          ))}
        </ul>
      </div>
    )}
    {infoHtml && <div class="prose mt-6 text-brand-secondary/70" set:html={infoHtml} />}
  </div>
  {/* p-6 on a phone, p-8 from sm: an 8-unit inset on each side of a 358px
      viewport spends nearly a fifth of the width on padding, which squeezes
      the fields the form exists for. py-3 on the fields (not py-2) puts
      every input over the 44px touch-target minimum. */}
  {showForm && (
    <form class="space-y-4 rounded-brand-lg border border-black/5 p-6 sm:p-8 shadow-brand-card bg-white">
      <div>
        <label class="block text-sm font-medium text-brand-secondary" for="name">Name</label>
        <input id="name" name="name" type="text" required class="mt-1 w-full rounded-brand-sm border border-black/10 px-4 py-3" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-secondary" for="email">Email</label>
        <input id="email" name="email" type="email" required class="mt-1 w-full rounded-brand-sm border border-black/10 px-4 py-3" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-secondary" for="message">Message</label>
        <textarea id="message" name="message" rows="4" required class="mt-1 w-full rounded-brand-sm border border-black/10 px-4 py-3"></textarea>
      </div>
      <p class="text-xs text-brand-secondary/50">
        Form submission handling is intentionally out of scope for this local PoC (no live hosting/server config). Wire this to a form endpoint at deploy time.
      </p>
      <button type="submit" class="w-full rounded-brand-md bg-brand-accent-strong px-6 py-3 text-sm font-semibold text-white">Send Message</button>
    </form>
  )}
</section>
